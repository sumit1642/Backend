{
	"name": "saas-blog-backend",
	"version": "1.0.0",
	"description": "Backend for a multi-user SaaS blog CMS using Express, JWT, and MySQL",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "node index.js",
		"dev": "nodemon index.js",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:watch": "vitest --watch",
		"test:unit": "vitest run __tests__/unit",
		"test:integration": "vitest run __tests__/integration",
		"test:api": "vitest run __tests__/api",
		"lint": "echo \"No linter configured\""
	},
	"keywords": [
		"express",
		"saas",
		"blog",
		"jwt",
		"mysql"
	],
	"author": "Sumit Yadav",
	"license": "MIT",
	"dependencies": {
		"@prisma/client": "^6.12.0",
		"bcryptjs": "^3.0.2",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"crypto-js": "^4.2.0",
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"prisma-mock": "^0.12.2",
		"supertest": "^7.1.4"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.9",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@vitest/coverage-v8": "^4.0.3",
		"nodemon": "^3.1.10",
		"prisma": "^6.12.0",
		"vitest": "^4.0.3"
	}
}
